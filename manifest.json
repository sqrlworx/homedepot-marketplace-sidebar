{
  "manifest_version": 3,
  "name": "Retail → Marketplace Finder",
  "version": "0.2.0",
  "description": "On a retail product page (Home Depot, Amazon, Target, Walmart), search Facebook Marketplace for the same or similar items and show results in a sidebar.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.homedepot.com/*",
    "https://www.amazon.com/*",
    "https://www.target.com/*",
    "https://www.walmart.com/*",
    "https://www.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://api.llama.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Marketplace Finder settings",
    "default_popup": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.homedepot.com/*",
        "https://www.amazon.com/*",
        "https://www.target.com/*",
        "https://www.walmart.com/*"
      ],
      "js": ["content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}
