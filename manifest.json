{
  "manifest_version": 3,
  "name": "Retail ↔ Marketplace Finder",
  "version": "0.3.0",
  "description": "On a retail product page, find the same item on Facebook Marketplace. On a Marketplace listing, identify the item from its photo and find it for sale new online.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Marketplace Finder settings",
    "default_popup": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.homedepot.com/*",
        "https://www.amazon.com/*",
        "https://www.target.com/*",
        "https://www.walmart.com/*",
        "https://www.facebook.com/marketplace/*"
      ],
      "js": ["content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}
